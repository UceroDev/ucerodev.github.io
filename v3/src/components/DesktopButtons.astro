---
export interface Props {
  titulo: string;
  icono: string;
  url: string;
}
const { titulo, icono, url } = Astro.props;
---

<div class="w-30">
  <a href={url} class="flex flex-col items-center hover:bg-[#ffffff49] hover:rounded-2xl">
    <img src={icono} class="w-20" />
    <h2 class="text-xl">{titulo}</h2>
  </a>
</div>
