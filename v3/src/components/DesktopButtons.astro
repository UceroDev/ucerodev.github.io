---
export interface Props {
  titulo: string;
  icono: string;
  url: string;
  posicion: string;
}
const { titulo, icono, url, posicion } = Astro.props;
---

<div class:list={["absolute w-40 -translate-x-1/2 -translate-y-1/2", posicion]}>
  <a href={url} class="flex flex-col items-center hover:bg-[#ffffff49] hover:rounded-2xl">
    <img src={icono} class="w-26" />
    <h2 class="text-2xl">{titulo}</h2>
  </a>
</div>
