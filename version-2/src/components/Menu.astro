---
// const navItemsClass =
import angleIcon from "../assets/svg/angle-down-solid.svg";
import angleUpIcon from "../assets/svg/angle-up-solid.svg";

const navItemsClass = "hover:bg-[#F5F5F5] text-black transition p-2 w-46 border-b-2 text-center"
---

<nav class="group mt-4 w-32 m-auto">
  <span class="group flex justify-center items-center gap-2">
    <p class="text-2xl">MENÚ</p>
    <img class="w-6 group-hover:hidden" src={angleIcon.src} alt="" />
    <img class="w-6 hidden group-hover:flex" src={angleUpIcon.src} alt="" />
  </span>
  <ul class="opacity-0 scale-y-0 group-hover:opacity-100 group-hover:scale-y-100 transition-all duration-300 origin-top pointer-events-none group-hover:pointer-events-auto mt-2 text-2xl">
    <li class={navItemsClass}>PROYECTOS</li>
    <li class={navItemsClass}>FORMACIÓN</li>
    <li class={navItemsClass}>EXPERIENCIA</li>
  </ul>
</nav>
