---
import TarjetaProyecto from "./TarjetaProyecto.astro";
const proyectos = [
  {
    titulo: "Web pública e interna de Erasmus",
    descripcion: "Continuación del desarrollo de la página interna que usa el instituto Nicolau Copèrnic para gestionar las prácticas en el estranjero, aparte de realizar modificaciones necesarias en la web pública.",
    imagen: "/src/assets/images/p1-erasmus.png",
    url: "/proyectos/1",
  },
  {
    titulo: "gastroGest",
    descripcion: "Sistema de gestión de restaurantes con TPV y Kitchen Display.",
    imagen: "/ruta/imagen2.jpg",
    url: "/proyectos/2",
  },
];
---

<style>
  .text-stroke {
    -webkit-text-stroke: 3px #383838;
  }
</style>

<section
  class="relative h-screen overflow-hidden bg-blanco-grisaceo flex flex-col items-center justify-center gap-10"
>
  <h2 class="text-8xl font-erica-one text-amarillo text-stroke">PROYECTOS</h2>

  <div class="flex gap-6 px-8 w-full justify-center">
    {proyectos.map((proyecto) => <TarjetaProyecto {...proyecto} />)}
  </div>
</section>
