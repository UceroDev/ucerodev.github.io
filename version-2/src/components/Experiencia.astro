---
import { experiencias } from '../data/experiencia.ts';
---

<style>
  .text-stroke {
    -webkit-text-stroke: 3px #d1d1d1;
  }
</style>

<section
  class="h-screen overflow-hidden bg-negro-grisaceo text-blanco-grisaceo flex items-center justify-center"
>
  <div>
      <h2 class="font-erica-one text-8xl mt-7 mb-12">EXPERIENCIA</h2>
    
      <div class="space-y-16">
        {
          experiencias.map((exp) => (
            <div>
              <div class="flex flex-col md:flex-row md:items-start gap-2 md:gap-6">
                <div class="flex flex-col md:w-48">
                  <span class="text-sm">{exp.fecha}</span>
                  {exp.contrato && (
                    <span class="text-xs text-gray-300">{exp.contrato}</span>
                  )}
                </div>
                <div class="flex flex-col">
                  <div class="flex items-center gap-4 flex-wrap">
                    <h3 class="text-4xl font-bold">{exp.empresa}</h3>
                    <div class="flex gap-2 flex-wrap">
                      {exp.skills.map((skill) => (
                        <span class="px-3 py-1 border border-blanco-grisaceo text-sm">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                  <p class="mt-3 text-sm text-gray-300 max-w-2xl">
                    {exp.descripcion}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
  </div>
</section>
