---
import { formaciones } from '../data/formacion';
---

<style>
  .text-stroke {
    -webkit-text-stroke: 3px #383838;
  }
</style>

<section
  class="h-screen overflow-hidden bg-blanco-grisaceo text-negro-grisaceo flex items-center justify-center text-right"
>
  <div>
      <h2 class="font-erica-one text-amarillo text-stroke text-8xl mt-7 mb-12">FORMACIÓN</h2>
    
      <div class="space-y-16">
        {
          formaciones.map((exp) => (
            <div>
              <div class="flex flex-col md:flex-row md:items-start gap-2 md:gap-6">
                <div class="flex flex-col md:w-48">
                  <span class="text-sm">{exp.fecha}</span>
                </div>
                <div class="flex flex-col">
                  <div class="flex items-center gap-4 flex-wrap">
                    <h3 class="text-4xl font-bold">{exp.formacion}</h3>
                  </div>
                  <p class="mt-3 text-sm max-w-2xl">
                    {exp.centro}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
  </div>
</section>
